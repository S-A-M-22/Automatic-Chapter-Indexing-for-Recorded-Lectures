<!DOCTYPE html>
<html>
<head>

<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;600&display=swap" rel="stylesheet">

<style>

:root{
--bg:#0f0f11;
--panel:#18181c;
--border:#2a2a30;
--accent:#e0291d;
--text:#e8e8ec;
--muted:#6b6b78;
--active-bg:rgba(224,41,29,0.12);
--hover-bg:rgba(255,255,255,0.04);
--low-value:#2e2e36;
--font-mono:'IBM Plex Mono', monospace;
--font-sans:'IBM Plex Sans', sans-serif;
}

body{
background:#0b0b0c;
margin:0;
padding:40px;
font-family:var(--font-sans);
}

#vp-root{
background:var(--bg);
color:var(--text);
border-radius:12px;
overflow:hidden;
border:1px solid var(--border);
display:flex;
flex-direction:column;
max-width:1100px;
margin:auto;
box-shadow:0 24px 64px rgba(0,0,0,0.6);
}

#vp-label{
padding:10px 18px;
font-family:var(--font-mono);
font-size:11px;
letter-spacing:0.15em;
text-transform:uppercase;
color:var(--muted);
border-bottom:1px solid var(--border);
}

#vp-body{
display:grid;
grid-template-columns:1fr 320px;
}

#vp-video-wrapper{
position:relative;
background:black;
aspect-ratio:16/9;
}

video{
width:100%;
height:100%;
object-fit:contain;
}

#vp-overlay-chapter{
position:absolute;
top:14px;
left:14px;
background:rgba(0,0,0,0.7);
padding:5px 10px;
border-radius:6px;
font-family:var(--font-mono);
font-size:11px;
}

#vp-chapters-list{
overflow-y:auto;
height:520px;
}

.ch-item{
padding:10px;
border-bottom:1px solid var(--border);
cursor:pointer;
}

.ch-item:hover{
background:var(--hover-bg);
}

.ch-name{
font-size:13px;
font-weight:600;
}

.ch-desc{
font-size:11px;
color:var(--muted);
}

.ch-meta{
display:flex;
align-items:center;
gap:8px;
margin-top:4px;
}

.ch-time{
font-family:monospace;
font-size:11px;
color:#bebebe;
}

.ch-id{
font-family:monospace;
font-size:11px;
color:#ecebeb;
}

.ch-badge{
font-size:10px;
padding:2px 6px;
border-radius:4px;
font-weight:600;
text-transform:uppercase;
letter-spacing:0.05em;
}

.ch-badge.high{
background:rgba(224,41,29,0.15);
color:#e0291d;
border:1px solid rgba(224,41,29,0.35);
}

.ch-badge.low{
background:#2e2e36;
color:#bebebe;
border:1px solid #444;
}

</style>
</head>

<body>

<div id="vp-root">

<div id="vp-label">
{{video_path.split("\\")[-1]}}
</div>

<div id="vp-body">

<div>

<div id="vp-video-wrapper">
<video id="vp-video" src="{{video_path}}" type="video/mp4" controls></video>
<div id="vp-overlay-chapter">—</div>
</div>

</div>

<div>

<div style="padding:12px;font-family:var(--font-mono);font-size:11px;border-bottom:1px solid #2a2a30">
Chapters
</div>

<div id="vp-chapters-list"></div>

</div>

</div>
</div>


<script>

const CHAPTERS={{chapters_json|safe}};
const TOTAL={{total_duration}};

const video=document.getElementById("vp-video");
const overlay=document.getElementById("vp-overlay-chapter");
const chList=document.getElementById("vp-chapters-list");

function currentChapter(t){
for(let i=CHAPTERS.length-1;i>=0;i--){
if(t>=CHAPTERS[i].start_sec) return i;
}
return 0;
}

CHAPTERS.forEach((ch,i)=>{

const item=document.createElement("div");
item.className="ch-item";

item.innerHTML=`
<div class="ch-name">${ch.chapter}</div>
<div class="ch-desc">${ch.description}</div>

<div class="ch-meta">
  <span class="ch-id">Chapter ${ch.ID}</span>
  <span class="ch-time">${ch.start_time}</span>
  <span class="ch-badge ${ch.low_value ? 'low' : 'high'}">
    ${ch.low_value ? 'skip' : 'key'}
  </span>
</div>
`;

item.onclick=()=>{
video.currentTime=ch.start_sec;
video.play();
};

chList.appendChild(item);

});

video.addEventListener("timeupdate",()=>{

const idx=currentChapter(video.currentTime);
overlay.innerText=CHAPTERS[idx].chapter;

});

</script>

</body>
</html>
